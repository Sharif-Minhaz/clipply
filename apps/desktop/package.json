{
  "name": "@clipply/desktop",
  "productName": "Clipply",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Clipply — end-to-end encrypted clipboard history",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --linux --dir"
  },
  "devDependencies": {
    "@clipply/crypto": "*",
    "@clipply/database": "*",
    "@clipply/logger": "*",
    "@clipply/shared-schemas": "*",
    "@clipply/sync-engine": "*",
    "@clipply/ui": "*",
    "@tailwindcss/vite": "^4.3.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/Sharif-Minhaz/clipply",
  "author": {
    "name": "Clipply"
  },
  "desktopName": "clipply.desktop"
