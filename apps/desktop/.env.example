# Clipply API base URL (your Vercel deployment), e.g. https://clipply-api.vercel.app
MAIN_VITE_API_URL=
# Google OAuth "Desktop app" client (docs/deployment.md §3). Desktop client secrets are not
# confidential by Google's design (RFC 8252); PKCE protects the flow.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
