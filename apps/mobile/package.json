{
  "name": "@clipply/mobile",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "android:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug && echo \"APK: apps/mobile/android/app/build/outputs/apk/debug/app-debug.apk\"",
    "android:install:usb": "bash scripts/install-android.sh usb",
    "android:install:wifi": "bash scripts/install-android.sh wifi",
    "android:live": "bash scripts/install-android.sh live usb",
    "android:live:wifi": "bash scripts/install-android.sh live wifi",
    "android:logs": "bash scripts/android-logs.sh",
    "android:open": "cap open android",
    "android:release": "vite build && cap sync android && cd android && ./gradlew assembleRelease && ls app/build/outputs/apk/release/*.apk",
    "android:sync": "vite build && cap sync android",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "icons:android": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@clipply/api-client": "*",
    "@clipply/crypto": "*",
    "@clipply/database": "*",
    "@clipply/logger": "*",
    "@clipply/shared-schemas": "*",
    "@clipply/sync-engine": "*",
    "@clipply/ui": "*",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/ben": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
