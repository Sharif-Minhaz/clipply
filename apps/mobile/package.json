{
  "name": "@clipply/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "android:sync": "vite build && cap sync android",
    "android:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:test": "cd android && ./gradlew testDebugUnitTest"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@clipply/api-client": "*",
    "@clipply/crypto": "*",
    "@clipply/database": "*",
    "@clipply/logger": "*",
    "@clipply/shared-schemas": "*",
    "@clipply/sync-engine": "*",
    "@clipply/ui": "*",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
