# MongoDB Atlas connection string (M0 free tier works; it is a replica set, so transactions work).
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_DB=clipply
# >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Comma-separated OAuth client IDs whose Google ID tokens are accepted (desktop + Android/web).
GOOGLE_CLIENT_IDS=
# Cloudinary (free plan, no card): Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vercel cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
# Origins allowed by CORS (the Capacitor WebView). The desktop app calls from Node and needs none.
CORS_ORIGINS=https://localhost,capacitor://localhost
