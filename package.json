{
  "name": "clipply",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gate": "npm run typecheck && npm test",
    "desktop:dev": "npm run dev -w @clipply/desktop",
    "desktop:dist": "npm run dist -w @clipply/desktop",
    "server:dev": "npm run dev -w @clipply/server",
    "server:build": "npm run build -w @clipply/server",
    "android:debug": "npm run android:debug -w @clipply/mobile",
    "android:release": "npm run android:release -w @clipply/mobile",
    "android:install:usb": "npm run android:install:usb -w @clipply/mobile",
    "android:install:wifi": "npm run android:install:wifi -w @clipply/mobile",
    "android:live": "npm run android:live -w @clipply/mobile",
    "android:live:wifi": "npm run android:live:wifi -w @clipply/mobile",
    "android:logs": "npm run android:logs -w @clipply/mobile",
    "publish": "node scripts/release.mjs all",
    "publish:ci": "node scripts/release.mjs ci",
    "release:dispatch": "node scripts/release.mjs dispatch",
    "release:bump": "node scripts/release.mjs bump",
    "release:build": "node scripts/release.mjs build",
    "release:build:linux": "node scripts/release.mjs build linux",
    "release:build:android": "node scripts/release.mjs build android",
    "release:tag": "node scripts/release.mjs tag",
    "release:push": "node scripts/release.mjs push",
    "release:upload": "node scripts/release.mjs upload"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1"
  }
}
